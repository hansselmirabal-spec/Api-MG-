{
  "info": {
    "_postman_id": "d5290fea-afd8-41ff-bbf6-18245945707c",
    "name": "MGAgencia Leads API — UAT (Sandbox)",
    "description": "UAT collection for the MGAgencia -> Salesforce Leads API v1 (functional spec section 8).\n\nSetup: import the environment file, fill in client_id and client_secret (delivered securely by Grupo Condor), then run the collection top to bottom with the Collection Runner.\n\nThe collection-level pre-request script obtains an OAuth 2.0 client-credentials token automatically and stores it in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Hardened v1.2: URLs/client_id resolve from collection variables even without an environment.",
          "// A fresh token is fetched at UAT-1 on every run; ad-hoc single requests fetch if no token is stored.",
          "if (pm.request.headers.get('Authorization')) {",
          "  const isFirst = (pm.info.requestName || '').indexOf('UAT-1') === 0;",
          "  const needFetch = isFirst || !pm.environment.get('access_token');",
          "  if (needFetch) {",
          "    const tokenUrl = pm.variables.get('token_url');",
          "    const cid = pm.variables.get('client_id');",
          "    const csec = pm.variables.get('client_secret');",
          "    if (!csec || String(csec).indexOf('PROVIDED') >= 0) { console.error('client_secret is not set — fill it in the environment.'); }",
          "    if (String(tokenUrl).indexOf('.my.salesforce.com') < 0) { console.error('token_url is WRONG (' + tokenUrl + ') — must be the org My Domain, not test/login.salesforce.com'); }",
          "    pm.sendRequest({",
          "      url: tokenUrl,",
          "      method: 'POST',",
          "      header: {'Content-Type':'application/x-www-form-urlencoded'},",
          "      body: { mode: 'urlencoded', urlencoded: [",
          "        {key:'grant_type', value:'client_credentials'},",
          "        {key:'client_id', value: cid},",
          "        {key:'client_secret', value: csec}",
          "      ]}",
          "    }, function (err, res) {",
          "      if (err || res.code !== 200) { console.error('TOKEN REQUEST FAILED', err || res.code, res && res.text()); return; }",
          "      pm.environment.set('access_token', res.json().access_token);",
          "      console.log('Token obtained OK from ' + tokenUrl);",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "UAT-1 - Valid lead -> 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fixed-length phone (Paraguay mobile: 10 digits, 0981XXXXXX). {{$randomInt}} alone yields 1-4 digits and produced inconsistent lengths.",
              "pm.variables.set('__uat1_phone', '0981' + String(Math.floor(100000 + Math.random() * 899999)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('status success', () => pm.expect(b.status).to.eql('success'));",
              "pm.test('code LEAD_CREATED', () => pm.expect(b.code).to.eql('LEAD_CREATED'));",
              "pm.test('integration_id is UUID', () => pm.expect(b.integration_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
              "pm.test('duplicated false', () => pm.expect(b.duplicated).to.eql(false));",
              "pm.environment.set('uat1_phone', JSON.parse(pm.request.body.raw).phone);",
              "pm.environment.set('uat1_integration_id', b.integration_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/services/apexrest/mgagencia/v1/leads",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "services",
            "apexrest",
            "mgagencia",
            "v1",
            "leads"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Maria\",\n  \"last_name\": \"Gonzalez UAT1\",\n  \"phone\": \"{{__uat1_phone}}\",\n  \"email\": \"uat1.{{$timestamp}}@example.com\",\n  \"branch_code\": \"ASUNCION\",\n  \"external_lead_id\": \"UAT-{{$timestamp}}-1\"\n}"
        }
      }
