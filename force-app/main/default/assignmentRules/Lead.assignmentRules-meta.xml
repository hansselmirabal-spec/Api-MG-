<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Asignacion al Admin</fullName>
        <active>false</active>
    </assignmentRule>
    <assignmentRule>
        <fullName>PreCalificacion</fullName>
        <active>false</active>
    </assignmentRule>
    <assignmentRule>
        <fullName>Reglas de Meta</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Reglas_Meta</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>Redes Sociales Empresa</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Status</field>
                <operation>equals</operation>
                <value>Formulario Meta</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Family__c</field>
                <operation>notEqual</operation>
                <value>AUTOMÓVILES MG</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>MGAgencia_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>MGAgencia</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Status</field>
                <operation>equals</operation>
                <value>Formulario MGAgencia</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
